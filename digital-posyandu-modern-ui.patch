+/* Consistent dashboard shell and content rhythm across every role page. */
+.dashboard-shell { min-height: 100vh; background: var(--surface-canvas); }
+.dashboard-header {
+  position: sticky; top: 0; z-index: 30;
+  display: flex; align-items: center; justify-content: space-between; gap: 1rem;
+  min-height: 68px; padding: .75rem clamp(1rem, 4vw, 2.5rem);
+  background: rgba(255,255,255,.9); backdrop-filter: blur(16px);
+  border-bottom: 1px solid var(--line);
+}
+.dashboard-brand { display: flex; align-items: center; gap: .7rem; min-width: 0; }
+.dashboard-brand-name { color: #126348; font-size: 1.05rem; font-weight: 750; letter-spacing: -.035em; white-space: nowrap; }
+.dashboard-brand-tag {
+  border: 1px solid #d6e9df; border-radius: 999px; padding: .28rem .6rem;
+  color: #34765c; background: #f0f8f3; font-size: .68rem; font-weight: 650; white-space: nowrap;
+}
+.dashboard-nav { display: flex; align-items: center; flex-wrap: wrap; gap: .25rem; }
+.dashboard-nav a {
+  border-radius: .7rem; padding: .55rem .75rem; color: #5f7067;
+  font-size: .78rem; font-weight: 650; text-decoration: none; transition: .18s ease;
+}
+.dashboard-nav a:hover { background: #edf6f0; color: #126348; }
+.dashboard-nav a:last-child { color: #a34c4c; }
+.dashboard-nav a:last-child:hover { background: #fff1f0; }
+.dashboard-main { width: min(100% - 2rem, 1160px); margin-inline: auto; padding-block: clamp(1.5rem, 3vw, 2.5rem); }
+.dashboard-main > * { min-width: 0; }
+
+/* Form and native-control polish for pages that use utility classes directly. */
+input:not([type="checkbox"]):not([type="radio"]), select, textarea {
+  accent-color: var(--brand-primary);
+}
+button { cursor: pointer; }
+button:disabled { cursor: not-allowed; }
+
+/* Keep chart tooltips and legends visually aligned with the design system. */
+.recharts-default-tooltip { border: 1px solid var(--line) !important; border-radius: 12px !important; box-shadow: 0 8px 24px rgba(20,43,33,.08) !important; }
+
+@media (max-width: 700px) {
+  .dashboard-header { align-items: flex-start; flex-direction: column; gap: .65rem; padding-block: .8rem; }
+  .dashboard-nav { width: 100%; overflow-x: auto; flex-wrap: nowrap; padding-bottom: .15rem; }
+  .dashboard-nav a { flex: 0 0 auto; }
+  .dashboard-main { width: min(100% - 1.25rem, 1160px); padding-block: 1.25rem; }
+  .posyandu-table { min-width: 620px; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; animation-duration: .01ms !important; }
 }
